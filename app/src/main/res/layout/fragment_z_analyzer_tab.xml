<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable name="fileSender" type="in.co.gorest.grblcontroller.listeners.FileSenderListener" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@android:color/white">

        <!-- Toolbar superiore: titolo + soglia -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#CC111111"
            android:padding="6dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Analisi Z"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="monospace"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Soglia mm:"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginEnd="4dp"
                tools:ignore="HardcodedText" />

            <!-- Pulsanti per regolare la soglia -->
            <ImageButton
                android:id="@+id/btnThresholdMinus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_input_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Soglia -" />

            <TextView
                android:id="@+id/tvThreshold"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FF4444"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:text="1.0" />

            <ImageButton
                android:id="@+id/btnThresholdPlus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_input_add"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Soglia +" />

            <ImageButton
                android:id="@+id/btnAnalyze"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_search"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Analizza"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Banner semaforo: verde/giallo/rosso a seconda della gravità -->
        <TextView
            android:id="@+id/tvVerdict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:gravity="center"
            android:background="#9E9E9E"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:text="Carica un file GCode e premi Analizza"
            tools:ignore="HardcodedText" />

        <!-- Info riepilogativa -->
        <TextView
            android:id="@+id/tvZInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:background="#F5F5F5"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="#333333"
            android:text=""
            tools:ignore="HardcodedText" />

        <!-- Heatmap strip: mostra dove nel programma cadono gli affondi -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:text="Mappa affondi (inizio → fine programma)"
            android:textColor="#666666"
            android:textSize="10sp"
            tools:ignore="HardcodedText,RtlSymmetry" />

        <in.co.gorest.grblcontroller.ui.ZHeatmapStripView
            android:id="@+id/zHeatmap"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="2dp" />

        <!-- Lista top-N affondi (sostituita dinamicamente nel fragment) -->
        <LinearLayout
            android:id="@+id/llTopDrops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FAFAFA"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            tools:ignore="RtlSymmetry" />

        <!-- Vista grafico custom — occupa tutto lo spazio rimasto -->
        <in.co.gorest.grblcontroller.ui.ZChartView
            android:id="@+id/zChartView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/white" />

    </LinearLayout>

</layout>
